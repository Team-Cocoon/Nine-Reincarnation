    ShowName: "\uC5F0\uC639"
    ImageName: Yeonong_Idle
    Script: "{fade a=3.5}\uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB294 \uC81C \uAC01\uAE30\uB9C8\uB2E4\uC758
      <bounce a=0.2>\u2018\uC778\uC5F0\uC758 \uC2E4\u2019</bounce>\uC744 \uAC00\uC9C0\uACE0
