  - ID: 201003
    ShowName: "\uC548\uB098"
    ImageName: Anna_Surprised
    Script: "{fade a=3.5}<shake>\uD5C9! \uB204\u2026\uB204\uAD6C\uC138\uC694??</>"
  - ID: 201004
    ShowName: "\uC5F0\uC639"
    ImageName: Yeonong_Idle
    Script: "{fade a=3.5}\uB0B4 \uC774\uB984\uC740 \uC5F0\uC639. \uC778\uC5F0\uC758
      \uC2E4\uC744 \uC5EE\uB294 \uC790\uC774\uB2E4."
  - ID: 201005
    ShowName: "\uC5F0\uC639"
    ImageName: Yeonong_Idle
    Script: "{fade a=3.5}\uC774\uC2B9\uC5D0\uC11C \uC218\uB9CE\uC740 \uC774\uB4E4\uC758
      \uC778\uC5F0\uB4E4\uC744 \uC774\uC5B4\uC8FC\uAE30\uB3C4 \uD558\uACE0, \uB04A\uC5B4\uC8FC\uAE30\uB3C4
      \uD558\uBA70 \uADF8\uB4E4\uC758 \uC6B4\uBA85\uACFC \uC0B6\uC744 \uBC14\uAFD4\uC900
      \uC790\uB85C\uC9C0."
  - ID: 201006
    ShowName: 
    ImageName: 
    Script: "{fade a=3.5}\uADF8\uB098\uC800\uB098 \uCC38\uC73C\uB85C \uAC00\uC5FE\uC740
      \uC6B4\uBA85\uC744 \uC9C0\uB2CC \uC790\uB85C\uAD6C\uB098."
  - ID: 201007
    ShowName: 
    ImageName: 
    Script: "{fade a=3.5}\uC774 \uAD6C\uCC9C\uC5D0,"
  - ID: 201008
    ShowName: 
    ImageName: 
    Script: "{fade a=3.5}\uADF8\uAC83\uB3C4 \uADF8\uB9AC \uB108\uB35C\uAC70\uB9AC\uB294
      \uC778\uC5F0\uC758 \uC2E4\uC744 \uAC00\uC9C0\uACE0 \uC788\uB2E4\uB2C8 \uB9D0\uC774\uB2E4."
  - ID: 201010
    ShowName: "\uC5F0\uC639"
    ImageName: Yeonong_Idle
    Script: "{fade a=3.5}\uADF8\uB798 \uAD6C\uCC9C. \uB108\uC640 \uB0B4\uAC00 \uC788\uB294
      \uC774 \uACF3\uC774 \uBC14\uB85C \uC8FD\uC9C0\uB3C4, \uC0B4\uC9C0\uB3C4 \uBABB\uD55C
      \uC601\uD63C\uB4E4\uC774 \uC874\uC7AC\uD558\uB294 \uACF5\uAC04. \uAD6C\uCC9C\uC774\uB2E4."
  - ID: 201011
    ShowName: "\uC548\uB098"
    ImageName: Anna_Confusion
    Script: "{fade a=3.5}<shake>\uADF8\u2026\uADF8\uB7F0 \uACF5\uAC04\uC5D0 \uC65C
      \uC81C\uAC00 \uC788\uB294 \uAC70\uC8E0? \uC800\uB294 \uC798\uBABB\uD55C \uAC8C
      \uC5C6\uB294\uB370\uC694\u2026!!</>"
  - ID: 201012
    ShowName: "\uC5F0\uC639"
    ImageName: Yeonong_Idle
    Script: "{fade a=3.5}\uADF8\uAC74 \uB0B4\uAC00 \uC54C \uC218 \uC5C6\uB2E8\uB2E4.
      \uC774 \uACF3\uC744 \uB2E4\uC2A4\uB9AC\uB294 <b>\uC6B4\uBA85\uC758 \uC2E0</b>\uB9CC\uC774
      \uC54C\uACA0\uC9C0\u2026"
  - ID: 201013
    ShowName: "\uC548\uB098"
    ImageName: Anna_Interested
    Script: "{fade a=3.5}\uADFC\uB370 \uC544\uAE4C \uB9D0\uC500\uD558\uC2E0 \uC800\uC5D0\uAC8C
      \uC788\uB2E4\uB294 <b>\uB108\uB35C\uAC70\uB9AC\uB294 \uC778\uC5F0\uC758 \uC2E4</b>\u2026?
      \uADF8\uAC74 \uB610 \uBB50\uC608\uC694?"
